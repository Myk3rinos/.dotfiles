#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: false,
    draw_borders: false,
    browser_column_widths: [20, 38, 42],
    text_color: "${COLOR_PRIMARY}",
    tab_bar: (
        enabled: true,
        active_style: (fg: "${COLOR_PRIMARY}", bg: "black", modifiers: "Bold"),
        inactive_style: (fg: "gray", modifiers: ""),
    ),
    highlighted_item_style: (fg: "${COLOR_PRIMARY}", modifiers: "Bold"),
    current_item_style: (fg: "${COLOR_INSERT}", bg: "black", modifiers: "Bold"),
    borders_style: (fg: "${COLOR_PRIMARY}", modifiers: "Bold"),
    highlight_border_style: (fg: "${COLOR_PRIMARY}"),
    symbols: (song: "󰝚 ", dir: " ", marker: "* ", ellipsis: "..."),
    progress_bar: (
        symbols: ["-", "", " "],
        track_style: (fg: "gray"),
        elapsed_style: (fg: "${COLOR_PRIMARY}"),
        thumb_style: (fg: "${COLOR_INSERT}"),
    ),
    scrollbar: (
        symbols: ["", "", "", ""],
        track_style: (fg: "gray"),
        ends_style: (fg: "${COLOR_PRIMARY}"),
        thumb_style: (fg: "${COLOR_PRIMARY}"),
    ),
    song_table_format: [
        (
            prop: (kind: Property(Title), style: (fg: "${COLOR_PRIMARY}"),
                highlighted_item_style: (fg: "${COLOR_PRIMARY}", modifiers: "Bold"),
                default: (kind: Property(Filename), style: (fg: "gray"),)
            ),
            width: "70%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "${COLOR_PRIMARY}"),
                default: (kind: Text("Unknown Album"), style: (fg: "${COLOR_PRIMARY}"))
            ),
            width: "30%",
        ),
    ],
    tabs: [
        (
            name: "Test",
            pane: Split(
                direction: Vertical,
                panes: [
                    (
                        size: "100%",
                        borders: "ALL",
                        pane: Split(
                            borders: "ALL",
                            direction: Horizontal,
                            panes: [
                                (
                                    size: "40%",
                                    borders: "RIGHT",
                                    pane: Pane(AlbumArt),
                                ),
                                (
                                    size: "60%",
                                    pane: Pane(Queue),
                                ),
                            ],
                        ),
                    ),
                    (
                        size: "3",
                        borders: "ALL",
                        pane: Split(
                            direction: Horizontal,
                            panes: [
                                (
                                    pane: Pane(Property(content: [(kind: Property(Status(StateV2())))], align: Left)),
                                    size: "10",
                                ),
                                (
                                    size: "100%",
                                    pane: Pane(ProgressBar),
                                ),
                                (
                                    size: "25",
                                    pane: Pane(Property(
                                        content: [
                                            (kind: Property(Status(Elapsed))),
                                            (kind: Text(" / ")),
                                            (kind: Property(Status(Duration))),
                                            (kind: Group([
                                                (kind: Text(" (")),
                                                (kind: Property(Status(Bitrate))),
                                                (kind: Text(" kbps)")),
                                            ])),
                                        ], align: Right,
                                    )),
                                ),
                            ]
                        ),
                    ),
                ],
            ),
        ),
    ],
    header: (
        rows: [
            (
                left: [
                    (kind: Property(Status(StateV2(playing_label: " ", paused_label: "❚❚", stopped_label: "❚❚"))), style: (fg: "${COLOR_INSERT}", modifiers: "Bold")),
                ],
                center: [
                    (kind: Property(Song(Title)), style: (fg: "${COLOR_PRIMARY}", modifiers: "Bold"),
                        default: (kind: Property(Song(Filename)), style: (fg: "${COLOR_PRIMARY}", modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Text("Vol: "), style: (fg: "${COLOR_PRIMARY}", modifiers: "Bold")),
                    (kind: Property(Status(Volume)), style: (fg: "${COLOR_VISUAL}", modifiers: "Bold")),
                    (kind: Text("% "), style: (fg: "${COLOR_PRIMARY}", modifiers: "Bold"))
                ]
            ),
            (
                left: [
                    (kind: Property(Status(Elapsed)), style: (fg: "${COLOR_INSERT}")),
                    (kind: Text("/"), style: (fg: "gray")),
                    (kind: Property(Status(Duration)), style: (fg: "${COLOR_PRIMARY}")),
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "${COLOR_PRIMARY}", modifiers: "Bold"),
                        default: (kind: Text("Unknown Artist"), style: (fg: "gray", modifiers: "Bold"))
                    ),
                ],
                right: [
                    (
                        kind: Property(Widget(States(
                            active_style: (fg: "${COLOR_PRIMARY}", modifiers: "Bold"),
                            separator_style: (fg: "gray")))
                        ),
                        style: (fg: "gray")
                    ),
                ]
            ),
        ],
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
)
